# Any long random string; used to sign Payload auth tokens.
# Generate one with: openssl rand -base64 32
# Changing it logs every admin user out.
PAYLOAD_SECRET=change-me

# Local SQLite file. Swap for a Postgres/Mongo adapter in payload.config.ts if needed.
# docker-compose overrides this to file:/data/argo.db, on a volume.
DATABASE_URI=file:./argo.db

# ---------------------------------------------------------------- deployment
# Only needed by docker-compose; local development ignores everything below.

# The domain Caddy requests a TLS certificate for, and the canonical origin
# baked into canonicals, the sitemap, robots and the OG images. No scheme.
SITE_DOMAIN=argorobotics.rs

# Where Let's Encrypt sends expiry warnings.
TLS_EMAIL=contact@argorobotics.rs

# Set true for the first boot of an empty database to write in the design copy,
# then set it back — otherwise a project an editor deleted comes back on restart.
ARGO_SEED=false

# Skips the startup build when a previous one exists. Faster restarts, at the
# cost of serving the previous build's content until something revalidates.
ARGO_SKIP_BUILD=false
